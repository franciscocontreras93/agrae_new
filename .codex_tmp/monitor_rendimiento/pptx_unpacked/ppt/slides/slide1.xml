1C4C34F4-F0AB-0449-15EB-542E19C843CA}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="5076976" y="168310"/><a:ext cx="4541855" cy="369332"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:solidFill><a:srgbClr val="92D050"/></a:solidFill></p:spPr><p:txBody><a:bodyPr wrap="square" rtlCol="0"><a:spAutoFit/></a:bodyPr><a:lstStyle/><a:p><a:pPr algn="ctr"/><a:r><a:rPr lang="es-ES" dirty="0"/><a:t>1. AJUSTE DE RINDES A HUMEDAD FIJA</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="10" name="CuadroTexto 9"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{8669B901-1868-1E22-1132-308E7AA0501E}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="5047053" y="590419"/><a:ext cx="6994222" cy="430887"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/></p:spPr><p:txBody><a:bodyPr wrap="square" rtlCol="0"><a:spAutoFit/></a:bodyPr><a:lstStyle/><a:p><a:r><a:rPr lang="es-ES" sz="1100" dirty="0"/><a:t>Como ves en los mapas hay un campo de humedad y otro de volumen o peso en húmedo. Para poder comparar es preciso llevar los valores a una misma humedad (R). Esta es la fórmula a aplicar a cada registro:</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="11" name="CuadroTexto 10"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{9F684D7F-E02E-E4C4-4036-ABB00273A166}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="5167223" y="1100650"/><a:ext cx="2021456" cy="307777"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/></p:spPr><p:txBody><a:bodyPr wrap="square" rtlCol="0"><a:spAutoFit/></a:bodyPr><a:lstStyle/><a:p><a:r><a:rPr lang="es-ES" sz="1400" dirty="0"/><a:t>R = </a:t></a:r><a:r><a:rPr lang="es-ES" sz="1400" dirty="0" err="1"/><a:t>Vh</a:t></a:r><a:r><a:rPr lang="es-ES" sz="1400" dirty="0"/><a:t> * (1-h) / (1-hr) </a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="12" name="CuadroTexto 11"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{BA790FBE-A561-8EA0-6322-7D938ABA1072}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="6944265" y="1074083"/><a:ext cx="5097009" cy="646331"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/></p:spPr><p:txBody><a:bodyPr wrap="square" rtlCol="0"><a:spAutoFit/></a:bodyPr><a:lstStyle/><a:p><a:r><a:rPr lang="es-ES" sz="1200" dirty="0" err="1"/><a:t>Vh</a:t></a:r><a:r><a:rPr lang="es-ES" sz="1200" dirty="0"/><a:t> = de los mapas, el campo que tiene la información de rinde</a:t></a:r></a:p><a:p><a:r><a:rPr lang="es-ES" sz="1200" dirty="0"/><a:t>h =de los mapas, el campo que tiene la información de humedad</a:t></a:r></a:p><a:p><a:r><a:rPr lang="es-ES" sz="1200" dirty="0" err="1"/><a:t>hr</a:t></a:r><a:r><a:rPr lang="es-ES" sz="1200" dirty="0"/><a:t> = la humedad de referencia a la que se quieren definir todos los registros</a:t></a:r></a:p></p:txBody></p:sp><p:cxnSp><p:nvCxnSpPr><p:cNvPr id="14" name="Conector recto 13"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{E85767DD-3ADA-48C6-4707-666FFCF12704}"/></a:ext></a:extLst></p:cNvPr><p:cNvCxnSpPr><a:cxnSpLocks/></p:cNvCxnSpPr><p:nvPr/></p:nvCxnSpPr><p:spPr><a:xfrm flipH="1"><a:off x="6749902" y="1093206"/><a:ext cx="194363" cy="608083"/></a:xfrm><a:prstGeom prst="line"><a:avLst/></a:prstGeom><a:ln w="28575"><a:solidFill><a:schemeClr val="tx1"><a:lumMod val="95000"/><a:lumOff val="5000"/></a:schemeClr></a:solidFill></a:ln></p:spPr><p:style><a:lnRef idx="1"><a:schemeClr val="accent1"/></a:lnRef><a:fillRef idx="0"><a:schemeClr val="accent1"/></a:fillRef><a:effectRef idx="0"><a:schemeClr val="accent1"/></a:effectRef><a:fontRef idx="minor"><a:schemeClr val="tx1"/></a:fontRef></p:style></p:cxnSp></p:grpSp><p:grpSp><p:nvGrpSpPr><p:cNvPr id="23" name="Grupo 22"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{F5EB9FE4-081F-E1E1-B018-2EE7015CF601}"/></a:ext></a:extLst></p:cNvPr><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr><a:xfrm><a:off x="4827855" y="1855246"/><a:ext cx="6994222" cy="3182789"/><a:chOff x="5047052" y="1861048"/><a:chExt cx="6994222" cy="3182789"/></a:xfrm></p:grpSpPr><p:sp><p:nvSpPr><p:cNvPr id="6" name="CuadroTexto 5"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{AAD1007F-0B35-78AA-A0A6-3F8FD5D5CA98}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="5078683" y="1861048"/><a:ext cx="4571778" cy="369332"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:solidFill><a:srgbClr val="92D050"/></a:solidFill></p:spPr><p:txBody><a:bodyPr wrap="square" rtlCol="0"><a:spAutoFit/></a:bodyPr><a:lstStyle/><a:p><a:pPr algn="ctr"/><a:r><a:rPr lang="es-ES" dirty="0"/><a:t>2. RINDES REALES</a:t></a:r></a:p></p:txBody></p:sp><p:grpSp><p:nvGrpSpPr><p:cNvPr id="22" name="Grupo 21"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{960436B7-D9AD-4FD3-F9A7-994054816993}"/></a:ext></a:extLst></p:cNvPr><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr><a:xfrm><a:off x="5569837" y="4397506"/><a:ext cx="6348376" cy="646331"/><a:chOff x="5595716" y="2716625"/><a:chExt cx="6348376" cy="646331"/></a:xfrm></p:grpSpPr><p:sp><p:nvSpPr><p:cNvPr id="17" name="CuadroTexto 16"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{A018D809-18ED-5380-5CEB-B65398278A90}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="6847083" y="2716625"/><a:ext cx="5097009" cy="646331"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/></p:spPr><p:txBody><a:bodyPr wrap="square" rtlCol="0"><a:spAutoFit/></a:bodyPr><a:lstStyle/><a:p><a:r><a:rPr lang="es-ES" sz="1200" dirty="0"/><a:t>PL = peso real del lote/s, es decir la cantidad de cosecha que se ha cosechado</a:t></a:r></a:p><a:p><a:r><a:rPr lang="es-ES" sz="1200" dirty="0"/><a:t>RL = rinde medio real de los lote/s</a:t></a:r></a:p><a:p><a:r><a:rPr lang="es-ES" sz="1200" dirty="0"/><a:t>SL = superficie de los lote/s de referencia </a:t></a:r></a:p></p:txBody></p:sp><p:cxnSp><p:nvCxnSpPr><p:cNvPr id="18" name="Conector recto 17"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{2E19E415-7569-5976-D571-86812F4EEA99}"/></a:ext></a:extLst></p:cNvPr><p:cNvCxnSpPr><a:cxnSpLocks/></p:cNvCxnSpPr><p:nvPr/></p:nvCxnSpPr><p:spPr><a:xfrm flipH="1"><a:off x="6656765" y="2754873"/><a:ext cx="194363" cy="608083"/></a:xfrm><a:prstGeom prst="line"><a:avLst/></a:prstGeom><a:ln w="28575"><a:solidFill><a:schemeClr val="tx1"><a:lumMod val="95000"/><a:lumOff val="5000"/></a:schemeClr></a:solidFill></a:ln></p:spPr><p:style><a:lnRef idx="1"><a:schemeClr val="accent1"/></a:lnRef><a:fillRef idx="0"><a:schemeClr val="accent1"/></a:fillRef><a:effectRef idx="0"><a:schemeClr val="accent1"/></a:effectRef><a:fontRef idx="minor"><a:schemeClr val="tx1"/></a:fontRef></p:style></p:cxnSp><p:sp><p:nvSpPr><p:cNvPr id="19" name="CuadroTexto 18"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{BFF5CED7-B5A2-510A-DA14-5D8CA11A10A9}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="5595716" y="2754873"/><a:ext cx="1061049" cy="307777"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/></p:spPr><p:txBody><a:bodyPr wrap="square" rtlCol="0"><a:spAutoFit/></a:bodyPr><a:lstStyle/><a:p><a:r><a:rPr lang="es-ES" sz="1400" dirty="0"/><a:t>RL = PL / SL</a:t></a:r></a:p></p:txBody></p:sp></p:grpSp><p:sp><p:nvSpPr><p:cNvPr id="21" name="CuadroTexto 20"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{F322EE55-2AE5-0508-6B4C-8039ACC91458}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="5047052" y="2252114"/><a:ext cx="6994222" cy="2123658"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/></p:spPr><p:txBody><a:bodyPr wrap="square" rtlCol="0"><a:spAutoFit/></a:bodyPr><a:lstStyle/><a:p><a:r><a:rPr lang="es-ES" sz="1100" dirty="0"/><a:t>Los mapas hay que ajustarlos con la producción real que se ha obtenido, y este ajuste aplicarlo al resto de los lotes de la explotación que tienen el mismo cultivo. Según esta fórmula:</a:t></a:r><a:br><a:rPr lang="es-ES" sz="1100" dirty="0"/></a:br><a:r><a:rPr lang="es-ES" sz="1100" dirty="0"/><a:t>Es importante que habrá explotaciones que tangamos información de cada lote (como en el caso de </a:t></a:r><a:r><a:rPr lang="es-ES" sz="1100" dirty="0" err="1"/><a:t>Coop</a:t></a:r><a:r><a:rPr lang="es-ES" sz="1100" dirty="0"/><a:t> </a:t></a:r><a:r><a:rPr lang="es-ES" sz="1100" dirty="0" err="1"/><a:t>Sta</a:t></a:r><a:r><a:rPr lang="es-ES" sz="1100" dirty="0"/><a:t> Barbara), en otras tendremos los valores de cantidad cosechada para todos los cultivos. Por ello propongo que </a:t></a:r><a:r><a:rPr lang="es-ES" sz="1100" u="sng" dirty="0"/><a:t>marquemos 3 niveles:</a:t></a:r><a:r><a:rPr lang="es-ES" sz="1100" dirty="0"/><a:t> </a:t></a:r></a:p><a:p><a:pPr marL="685800" lvl="1" indent="-228600"><a:buFont typeface="+mj-lt"/><a:buAutoNum type="arabicPeriod"/></a:pPr><a:r><a:rPr lang="es-ES" sz="1100" b="1" dirty="0"/><a:t>En el caso que tengamos el valor de cada lote</a:t></a:r></a:p><a:p><a:pPr marL="685800" lvl="1" indent="-228600"><a:buFont typeface="+mj-lt"/><a:buAutoNum type="arabicPeriod"/></a:pPr><a:r><a:rPr lang="es-ES" sz="1100" b="1" dirty="0"/><a:t>En el caso que tengamos el valor de un conjunto de lotes. </a:t></a:r></a:p><a:p><a:pPr marL="685800" lvl="1" indent="-228600"><a:buFont typeface="+mj-lt"/><a:buAutoNum type="arabicPeriod"/></a:pPr><a:r><a:rPr lang="es-ES" sz="1100" b="1" dirty="0"/><a:t>En el caso de que tengamos valores globales, es decir la cantidad total de trigo, cebada, etc. De la explotación.</a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="es-ES" sz="1100" i="1" dirty="0"><a:solidFill><a:srgbClr val="002060"/></a:solidFill></a:rPr><a:t>En el caso es que según se vaya rellenando el valor de los lotes (1.) se vaya calculado un valor medio de la explotación. En el caso 2. y 3. que directamente se rellene el valor medio de la explotación de forma manual/directa</a:t></a:r></a:p></p:txBody></p:sp></p:grpSp></p:spTree><p:extLst><p:ext uri="{BB962C8B-B14F-4D97-AF65-F5344CB8AC3E}"><p14:creationId xmlns:p14="http://schemas.microsoft.com/office/powerpoint/2010/main" val="3700089710"/></p:ext></p:extLst></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>