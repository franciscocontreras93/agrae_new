  <mapTip enabled="1">&lt;div style="padding:12px; font-family:Segoe UI, Arial, sans-serif; font-size:12px; line-height:1.25; min-width:260px;">&#xd;
&#xd;
  &lt;!-- Título -->&#xd;
  &lt;div style="font-size:16px; font-weight:800; margin-bottom:10px;">&#xd;
    [% coalesce("lote",'') %]&#xd;
  &lt;/div>&#xd;
&#xd;
  &lt;!-- Tabla -->&#xd;
  &lt;table style="border-collapse:separate; border-spacing:0; width:100%; border:1px solid #e5e7eb; border-radius:10px; overflow:hidden;">&#xd;
    &lt;tr>&#xd;
      &lt;td style="padding:7px 9px; background:#f3f4f6; font-weight:700; width:44%; border-bottom:1px solid #e5e7eb;">&#xd;
        F. Madurez Estimada&#xd;
      &lt;/td>&#xd;
      &lt;td style="padding:7px 9px; border-bottom:1px solid #e5e7eb;">&#xd;
        [% format_date("fechacosecha_pred", 'dd/MM/yyyy') %]&#xd;
      &lt;/td>&#xd;
    &lt;/tr>&#xd;
&#xd;
    &lt;tr>&#xd;
      &lt;td style="padding:7px 9px; background:#f3f4f6; font-weight:700; border-bottom:1px solid #e5e7eb;">&#xd;
        IT. Acumulada&#xd;
      &lt;/td>&#xd;
      &lt;td style="padding:7px 9px; border-bottom:1px solid #e5e7eb;">&#xd;
        [% round(it_acumulada) %] / [%it_objetivo%] °C&#xd;
      &lt;/td>&#xd;
    &lt;/tr>&#xd;
&#xd;
    &lt;tr>&#xd;
      &lt;td style="padding:7px 9px; background:#f3f4f6; font-weight:700;">&#xd;
        Avance&#xd;
      &lt;/td>&#xd;
      &lt;td style="padding:7px 9px;">&#xd;
        [% round("avance_pct") %]%&#xd;
      &lt;/td>&#xd;
    &lt;/tr>&#xd;
  &lt;/table>&#xd;
&#xd;
  &lt;!-- Barra de avance -->&#xd;
  &lt;div style="margin-top:8px; border:1px solid #e5e7eb; border-radius:999px; height:10px; overflow:hidden; background:#f3f4f6;">&#xd;
    &lt;div style="&#xd;
      height:10px;&#xd;
      width:[% round(coalesce("avance_pct",0),0) %]%;&#xd;
      background:[% if(coalesce("avance_pct",0) >= 90, '#16a34a',&#xd;
                if(coalesce("avance_pct",0) >= 60, '#22c55e',&#xd;
                if(coalesce("avance_pct",0) >= 30, '#f59e0b', '#ef4444'))) %];&#xd;
    ">&lt;/div>&#xd;
  &lt;/div>&#xd;
&#xd;
  &lt;!-- Badge etapa -->&#xd;
  &lt;div style="margin-top:10px;">&#xd;
    &lt;span style="&#xd;
      display:inline-block;&#xd;
      padding:6px 10px;&#xd;
      border-radius:999px;&#xd;
      font-weight:800;&#xd;
      font-size:13px;&#xd;
      background:[% if("is_hito", '#DCFCE7', '#E5E7EB') %];&#xd;
      color:[% if("is_hito", '#166534', '#111827') %];&#xd;
      border:1px solid [% if("is_hito", '#86efac', '#d1d5db') %];&#xd;
    ">&#xd;
      [% coalesce("etapa_actual",'') %]&#xd;
    &lt;/span>&#xd;
&#xd;
    &lt;span style="margin-left:8px; font-size:11px; color:#6b7280;">&#xd;
      [% manejo_cur_nombre %]&#xd;
    &lt;/span>&#xd;
  &lt;/div>&#xd;
&#xd;
